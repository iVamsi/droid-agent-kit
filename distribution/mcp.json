{
  "bundle": {
    "id": "droidagentkit",
    "name": "DroidAgentKit",
    "version": "0.2.2-alpha",
    "description": "Local-first Android development MCP server.",
    "license": "Apache-2.0",
    "homepage": "https://github.com/iVamsi/droid-agent-kit"
  },
  "server": {
    "command": "droidagent-mcp",
    "args": [],
    "transport": "stdio",
    "env": {
 "DROIDAGENT_BIN": "${DROIDAGENT_BIN}"
    }
  },
  "runtime": {
    "type": "jvm",
    "minJavaVersion": 17,
    "localOnly": true
  }
}
